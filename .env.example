DATABASE_URI=postgres://gptc:gptc@localhost:5432/gptc
PAYLOAD_SECRET=replace-me-with-32-plus-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PREVIEW_SECRET=replace-me-16-plus-chars
REVALIDATE_SECRET=replace-me-16-plus-chars
RESEND_API_KEY=
EMAIL_FROM=hello@gptcplays.com

# Production-only (docker-compose.yml expects)
POSTGRES_PASSWORD=replace-with-strong-password
# Image to deploy, published by CI to GHCR. Replace <owner> with your GitHub user/org.
APP_IMAGE=ghcr.io/<owner>/gptc:latest
# Apex domain Traefik routes to (no scheme, no www). Drives the Host rule + www redirect.
# In production this ALSO drives Payload's CORS/CSRF allow-list (apex + www), so the
# admin can save without "You are not allowed to do this action". MUST be set.
APP_DOMAIN=greatplainstheatrecommons.org

# REQUIRED in production. Must be the exact public origin the browser uses, or the
# admin will intermittently reject saves (CSRF). Keep in sync with APP_DOMAIN.
#   NEXT_PUBLIC_SERVER_URL=https://greatplainstheatrecommons.org

# Automated DB backups (db-backup service). Defaults are sane; override to taste.
# SCHEDULE uses go-cron syntax ("@every 6h", "@daily", "0 30 3 * * *", ...).
BACKUP_SCHEDULE=@every 6h
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=12
